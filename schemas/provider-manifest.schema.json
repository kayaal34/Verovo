{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verovo.dev/schemas/provider-manifest.schema.json",
  "title": "Verovo Provider Manifest",
  "description": "Local adapter metadata and observed readiness. A valid manifest does not claim that an upstream engine was contacted or that its records are complete.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "adapter_id",
    "engine",
    "source",
    "readiness_checks",
    "limits",
    "coverage",
    "cleanup",
    "raw_snapshot_refs",
    "normalization_rule_version"
  ],
  "properties": {
    "schema": {"const": "verovo.provider-manifest/0.1"},
    "adapter_id": {"type": "string", "minLength": 1},
    "engine": {"$ref": "#/$defs/engine"},
    "source": {"$ref": "#/$defs/source"},
    "readiness_checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/readinessCheck"}
    },
    "limits": {"$ref": "#/$defs/limits"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "cleanup": {"$ref": "#/$defs/cleanup"},
    "raw_snapshot_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "normalization_rule_version": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "integration_mode"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "integration_mode": {
          "type": "string",
          "enum": ["file", "process", "http", "embedded"]
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"integration_mode": {"const": "process"}},
            "required": ["integration_mode"]
          },
          "then": {"required": ["executable_sha256"]}
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["party", "control_domain", "collector_party", "collection_method"],
      "properties": {
        "party": {"type": "string", "minLength": 1},
        "control_domain": {"type": "string", "minLength": 1},
        "collector_party": {"type": "string", "minLength": 1},
        "collection_method": {"type": "string", "minLength": 1}
      }
    },
    "readinessCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "status", "required", "observed"],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["pass", "fail", "unknown"]},
        "required": {"type": "boolean"},
        "observed": {"type": "string", "minLength": 1}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_bytes", "output_bytes", "depth", "cpu_seconds", "timeout_ms"],
      "properties": {
        "input_bytes": {"type": "integer", "minimum": 1},
        "output_bytes": {"type": "integer", "minimum": 1},
        "depth": {"type": "integer", "minimum": 1},
        "cpu_seconds": {"type": "integer", "minimum": 1},
        "timeout_ms": {"type": "integer", "minimum": 1}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "matched", "unmatched", "duplicates", "rejected", "omitted"],
      "properties": {
        "status": {"type": "string", "enum": ["complete", "partial", "unknown"]},
        "matched": {"type": "integer", "minimum": 0},
        "unmatched": {"type": "integer", "minimum": 0},
        "duplicates": {"type": "integer", "minimum": 0},
        "rejected": {"type": "integer", "minimum": 0},
        "omitted": {"type": "integer", "minimum": 0}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["released", "retained", "unknown"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
